{
  "id": "the_wolf",
  "title": "The Injured Wolf",
  "start": "encounter",
  "macros": {
    "rememberMercy": {
      "do": [
        {
          "type": "remember",
          "concepts": [
            "player",
            "help",
            "wolf",
            "mercy"
          ],
          "metadata": {
            "theme": "mercy"
          }
        }
      ]
    },
    "isMerciful": {
      "condition": {
        "type": "association",
        "a": "player",
        "b": "mercy",
        "min": 1
      }
    }
  },
  "nodes": {
    "encounter": {
      "text": "An injured wolf lies beside the path. Its flank rises and falls with shallow breaths.",
      "onEnter": [
        {
          "type": "remember",
          "concepts": [
            "forest",
            "wolf",
            "injured"
          ],
          "metadata": {
            "scene": "encounter"
          }
        }
      ],
      "choices": [
        {
          "id": "help",
          "text": "Bind its wound",
          "do": [
            {
              "type": "macro",
              "name": "rememberMercy"
            }
          ],
          "goto": "after"
        },
        {
          "id": "ignore",
          "text": "Leave it alone",
          "do": [
            {
              "type": "remember",
              "concepts": [
                "player",
                "ignore",
                "wolf",
                "indifference"
              ]
            }
          ],
          "goto": "after"
        },
        {
          "id": "harm",
          "text": "Put it out of its misery",
          "do": [
            {
              "type": "remember",
              "concepts": [
                "player",
                "kill",
                "wolf",
                "violence"
              ]
            }
          ],
          "goto": "after"
        }
      ]
    },
    "after": {
      "text": [
        {
          "if": {
            "type": "macroCondition",
            "name": "isMerciful"
          },
          "value": "The wolf watches you with wary, living eyes. It remembers your hands were gentle."
        },
        {
          "if": {
            "type": "association",
            "a": "player",
            "b": "violence",
            "min": 1
          },
          "value": "The forest seems quieter after what you have done."
        },
        {
          "value": "You continue down the path, leaving the encounter behind."
        }
      ],
      "choices": [
        {
          "id": "continue",
          "text": "Continue",
          "goto": "end"
        }
      ]
    },
    "end": {
      "text": "The path bends towards the village.",
      "ending": true,
      "choices": []
    }
  }
}